FROM python:3.11-slim

WORKDIR /app
COPY src/warehouse/requirements.txt /tmp/warehouse-requirements.txt
RUN pip install --no-cache-dir -r /tmp/warehouse-requirements.txt

COPY src/warehouse /app/warehouse
COPY tests /app/tests

ENV PYTHONPATH=/app
ENV RUN_DB_INTEGRATION=1
ENV WAREHOUSE_TEST_IN_CONTAINER=1

CMD ["python", "-m", "unittest", "tests.test_database_initialization.TestDatabaseBootstrapIntegration", "-v"]
