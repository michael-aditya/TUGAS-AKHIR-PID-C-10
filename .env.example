# Topik 2A — Industrial Predictive Maintenance (CNC Production Line)
# Copy this file to .env if you want to override defaults locally.

# Messaging & Raw Storage (Ticket 01 & 02)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=sensors/cnc/+/+
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_TOPIC=cnc.telemetry.raw
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=cnc_raw

# Simulator & Dirty Data Injection Controls (Ticket 01 & 02)
BACKFILL_DAYS=7
BACKFILL_INTERVAL_SECONDS=300
LIVE_INTERVAL_SECONDS=1.0
SIMULATOR_SEED=42
FAULT_RATE_MISSING=0.015
FAULT_RATE_DUPLICATE=0.015
FAULT_RATE_OUT_OF_RANGE=0.015
FAULT_RATE_STUCK_SENSOR=0.005
FAULT_RATE_INCONSISTENT_FORMAT=0.020
FAULT_RATE_LATE_EVENT=0.015

# Optional Real-Time PostgreSQL Sink (Activated once Ticket 03 adds PostgreSQL)
POSTGRES_DSN=
